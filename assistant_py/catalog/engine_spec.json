{
 "_about": "Executable specification of the catalogue query engine (tools/catalog_engine.py). Per dataset: where the file is, which columns to read, the dimensions (group by and filters), the metrics (pandas expression on df = the selected rows, p = parameters, rows_of(id) = rows of another dataset) and the warnings that touch a figure. The meaning, grain and caveats in prose stay in semantic_layer.json; build_catalog.py / catalog_engine.py selftest check that the two agree. Expressions are written in this repository, never taken from a user or a model. 'sources' are tried in order; @data = the folder of the data repositories (SIA_DATA_ROOT, or the folder above the agent repository), @dash = the AFRO-Dash folder, @here = the assistant's own folder. A dataset with no source found is 'not available' in that installation.",
 "datasets": {
  "lqas": {
   "semantic": "lqas",
   "date_col": "lqas_start_date",
   "entity": "lots",
   "dims": {
    "country": "country",
    "year": "year",
    "vaccine": "vaccine.type",
    "status": "status",
    "performance": "performance",
    "round": "roundNumber",
    "response": "response",
    "block": "afro_block",
    "province": "province",
    "district": "district",
    "missed_in_lot": "total_missed",
    "geo_code": "geo_code"
   },
   "metrics": {
    "lots": {
     "unit": "lots",
     "def": "number of lots assessed",
     "formula": "number of rows",
     "expr": "len(df)",
     "kind": "scalar"
    },
    "pass_rate": {
     "unit": "percent of lots",
     "def": "share of lots that pass (at most 3 children missed in the lot of 60)",
     "formula": "100 * mean(status == 'Pass')",
     "expr": "100*(df.status=='Pass').mean()",
     "kind": "scalar"
    },
    "missed_children_rate": {
     "unit": "percent of children sampled",
     "def": "the dashboard missed rate: sampled children not found vaccinated over children sampled",
     "formula": "100 * (1 - sum(total_vaccinated) / sum(total_sampled))",
     "expr": "100*(1-df.total_vaccinated.sum()/df.total_sampled.sum())",
     "kind": "scalar"
    },
    "coverage_of_sampled": {
     "unit": "percent of children sampled",
     "def": "the dashboard LQAS coverage: sampled children found vaccinated over children sampled",
     "formula": "100 * sum(total_vaccinated) / sum(total_sampled)",
     "expr": "100*df.total_vaccinated.sum()/df.total_sampled.sum()",
     "kind": "scalar"
    },
    "children_sampled": {
     "unit": "children",
     "def": "children sampled",
     "formula": "sum(total_sampled)",
     "expr": "df.total_sampled.sum()",
     "kind": "scalar"
    },
    "children_vaccinated": {
     "unit": "children",
     "def": "sampled children found vaccinated (NOT the number of children vaccinated in the country)",
     "formula": "sum(total_vaccinated)",
     "expr": "df.total_vaccinated.sum()",
     "kind": "scalar"
    },
    "children_missed": {
     "unit": "children",
     "def": "sampled children not found vaccinated",
     "formula": "sum(total_sampled) - sum(total_vaccinated)",
     "expr": "df.total_sampled.sum()-df.total_vaccinated.sum()",
     "kind": "scalar"
    },
    "total_missed_lot_measure": {
     "unit": "children (lot measure)",
     "def": "60 minus vaccinated in every lot: also counts the children never sampled in under-reported lots; used for pass or fail",
     "formula": "sum(total_missed)",
     "expr": "df.total_missed.sum()",
     "kind": "scalar"
    },
    "unsampled_counted_missed": {
     "unit": "children",
     "def": "children never sampled but counted as missed in under-reported lots (60 minus sampled)",
     "formula": "sum(pmax(60 - total_sampled, 0))",
     "expr": "(60-df.total_sampled).clip(lower=0).sum()",
     "kind": "scalar"
    },
    "under_reported_lots": {
     "unit": "lots",
     "def": "lots with fewer than 60 children sampled",
     "formula": "sum(total_sampled < 60)",
     "expr": "(df.total_sampled<60).sum()",
     "kind": "scalar"
    },
    "districts": {
     "unit": "districts",
     "def": "distinct districts with at least one lot",
     "formula": "distinct (country, province, district)",
     "expr": "len(df[['country','province','district']].drop_duplicates())",
     "kind": "scalar"
    },
    "countries": {
     "unit": "countries",
     "def": "distinct countries with at least one lot",
     "formula": "distinct country",
     "expr": "df.country.nunique()",
     "kind": "scalar"
    },
    "campaigns": {
     "unit": "campaigns",
     "def": "distinct campaign names (the response column) with lots; a campaign has several rounds, and the dashboard's 'Campaigns' tile counts rounds (metric rounds), not names",
     "formula": "distinct response",
     "expr": "df.response.nunique()",
     "kind": "scalar"
    },
    "lots_below_3_clusters": {
     "unit": "lots",
     "def": "lots with fewer than 30 children sampled (1 or 2 clusters), which all fail",
     "formula": "sum(total_sampled < 30)",
     "expr": "(df.total_sampled<30).sum()",
     "kind": "scalar"
    },
    "share_without_geo_code": {
     "unit": "percent of lots",
     "def": "share of lots with no AFROGDB geo_code",
     "formula": "100 * mean(is.na(geo_code))",
     "expr": "100*df.geo_code.isna().mean()",
     "kind": "scalar"
    },
    "latest_date": {
     "unit": "date",
     "def": "date of the most recent survey (round start date)",
     "formula": "max(lqas_start_date)",
     "expr": "df['.date'].max()",
     "kind": "date"
    },
    "reasons": {
     "unit": "children",
     "def": "reasons for missed children (sum of the r_* counts) with their share; over complete lots (60 sampled) unless complete_lots_only is false",
     "formula": "sum of r_* columns over lots with total_sampled == 60",
     "expr": "(lambda x: (lambda s: pd.DataFrame({'reason':s.index,'children':s.values.astype(int),'share_percent':(100*s/s.sum()).round(1).values}).sort_values('children',ascending=False))(x[['r_non_compliance','r_house_not_visited','r_childabsent','r_Child_was_asleep','r_Child_is_a_visitor','r_Vaccinated_but_not_FM','r_security','r_childnotborn','other_r']].apply(pd.to_numeric, errors='coerce').sum()))(df[df.total_sampled==60] if p.get('complete_lots_only',True) else df)",
     "kind": "table"
    },
    "rounds": {
     "unit": "rounds",
     "def": "campaign rounds with lots, as the dashboard counts its 'Campaigns' tile: distinct (country, response, vaccine type, round label), text trimmed and upper-cased, rows without those fields or without a round start date left out",
     "formula": "distinct (country, response, vaccine.type, roundNumber)",
     "expr": "len(df.dropna(subset=['country','response','vaccine.type','roundNumber','round_start_date']).assign(c=lambda x: x.country.astype(str).str.strip().str.upper(), r=lambda x: x.response.astype(str).str.strip().str.upper(), v=lambda x: x['vaccine.type'].astype(str).str.strip().str.upper(), n=lambda x: x.roundNumber.astype(str))[['c','r','v','n']].drop_duplicates())",
     "kind": "scalar"
    },
    "latest_round_start": {
     "unit": "date",
     "def": "start date of the most recent round (round_start_date, the dashboard's 'SIA date'); the LQAS survey date (latest_date) is a few days later",
     "formula": "max(round_start_date)",
     "expr": "pd.to_datetime(df.round_start_date, errors='coerce').max()",
     "kind": "date"
    }
   },
   "warnings": [
    {
     "metrics": [
      "pass_rate",
      "total_missed_lot_measure",
      "lots",
      "reasons"
     ],
     "count": "int((df.total_sampled<60).sum())",
     "text": "{n} of {rows} lots are under-reported (fewer than 60 children sampled); they count the unsampled children as missed."
    },
    {
     "metrics": [
      "total_missed_lot_measure"
     ],
     "text": "This is the lot measure; the dashboard missed rate (missed_children_rate) is lower."
    },
    {
     "metrics": [
      "children_vaccinated"
     ],
     "text": "These are sampled children found vaccinated, not the number of children vaccinated: use the administrative data for that."
    },
    {
     "metrics": [
      "pass_rate",
      "lots"
     ],
     "count": "int(((df.country.str.upper()=='NIGERIA')&(df.total_sampled<30)).sum())",
     "text": "{n} Nigerian lot(s) have only 1 or 2 clusters (under 30 children) and all fail."
    },
    {
     "metrics": [
      "reasons"
     ],
     "text": "'other' also holds the unsampled children of under-reported lots: it is mostly an artifact in the whole file.",
     "only_if": "not p.get('complete_lots_only',True)"
    },
    {
     "metrics": [
      "campaigns"
     ],
     "text": "This counts campaign NAMES; the dashboard's 'Campaigns' tile counts rounds (campaign, vaccine and round label): use the metric rounds to match the dashboard."
    },
    {
     "metrics": [
      "latest_date"
     ],
     "text": "This is the date of the most recent LQAS SURVEY (lqas_start_date); the round itself starts a few days earlier (latest_round_start, the dashboard's 'SIA date')."
    }
   ],
   "sources": [
    {
     "kind": "csv",
     "path": "@data/Posit-LQAS-Workflow/data/final/afro_lqas_repositorty.csv"
    },
    {
     "kind": "rds",
     "path": "@dash/input/AFRO_LQAS_data_c.rds"
    },
    {
     "kind": "rds",
     "path": "@here/data/AFRO_LQAS_data_c.rds"
    }
   ],
   "round_key": [
    "response",
    "vaccine",
    "round"
   ],
   "round_date": "round_start_date"
  },
  "admin": {
   "semantic": "admin",
   "date_col": "SIA_date",
   "entity": "records",
   "dims": {
    "country": "Country",
    "year": "Year",
    "vaccine": "Vaccine_type",
    "block": "AFRO_block",
    "response": "Response",
    "round": "Round_Add",
    "province": "Province",
    "geo_code": "geo_code"
   },
   "metrics": {
    "records": {
     "unit": "records",
     "def": "number of district-round-vaccine records",
     "formula": "number of rows",
     "expr": "len(df)",
     "kind": "scalar"
    },
    "children_vaccinated": {
     "unit": "children",
     "def": "children vaccinated, as the dashboard's 'Children vaccinated' tile: for each country the month with the most vaccinations (sum of TotalNbrVaccPolio in that SIA month), then summed over countries, so that the same children vaccinated in several rounds are not added again (an estimate of distinct children)",
     "formula": "sum over countries of max over months of sum(TotalNbrVaccPolio) (MR excluded)",
     "expr": "df[df.Vaccine_type!='MR'].dropna(subset=['.date']).groupby(['Country','.month']).TotalNbrVaccPolio.sum().groupby(level=0).max().sum()",
     "kind": "scalar"
    },
    "target_population": {
     "unit": "children",
     "def": "polio target population of the records (MR excluded)",
     "formula": "sum(PopPolio) where Vaccine_type != 'MR'",
     "expr": "df[df.Vaccine_type!='MR'].PopPolio.sum()",
     "kind": "scalar"
    },
    "coverage": {
     "unit": "ratio (1.00 = 100%)",
     "def": "administrative coverage: children vaccinated over target, over records that have both figures and a target above zero, MR excluded",
     "formula": "sum(TotalNbrVaccPolio) / sum(PopPolio)",
     "expr": "(lambda d: d.TotalNbrVaccPolio.sum()/d.PopPolio.sum())(df[df.Vaccine_type!='MR'].dropna(subset=['TotalNbrVaccPolio','PopPolio']).query('PopPolio>0'))",
     "kind": "scalar"
    },
    "share_districts_95": {
     "unit": "percent of records",
     "def": "share of district records with coverage of at least 95%",
     "formula": "100 * mean(TotalNbrVaccPolio / PopPolio >= 0.95)",
     "expr": "(lambda d: 100*((d.TotalNbrVaccPolio/d.PopPolio)>=0.95).mean())(df[df.Vaccine_type!='MR'].dropna(subset=['TotalNbrVaccPolio','PopPolio']).query('PopPolio>0'))",
     "kind": "scalar"
    },
    "records_above_1_5": {
     "unit": "records",
     "def": "records with coverage above 1.5 (not credible)",
     "formula": "sum(TotalNbrVaccPolio / PopPolio > 1.5)",
     "expr": "((df.TotalNbrVaccPolio/df.PopPolio)>1.5).sum()",
     "kind": "scalar"
    },
    "campaigns": {
     "unit": "campaigns",
     "def": "distinct campaign names (the Response column); a campaign has several rounds (metric rounds)",
     "formula": "distinct Response",
     "expr": "df.Response.nunique()",
     "kind": "scalar"
    },
    "countries": {
     "unit": "countries",
     "def": "distinct countries with records",
     "formula": "distinct Country",
     "expr": "df.Country.nunique()",
     "kind": "scalar"
    },
    "share_co_administered": {
     "unit": "percent of records",
     "def": "share of records of co-administered campaigns (nOPV2 & bOPV, or nOPV2_bOPV_IPV)",
     "formula": "100 * mean(Vaccine_type in co-administered)",
     "expr": "100*df.Vaccine_type.isin(['nOPV2 & bOPV','nOPV2_bOPV_IPV']).mean()",
     "kind": "scalar"
    },
    "records_without_geo_code": {
     "unit": "records",
     "def": "records with no AFROGDB geo_code",
     "formula": "sum(is.na(geo_code))",
     "expr": "df.geo_code.isna().sum()",
     "kind": "scalar"
    },
    "latest_date": {
     "unit": "date",
     "def": "latest SIA start date in the data",
     "formula": "max(SIA_date)",
     "expr": "df['.date'].max()",
     "kind": "date"
    },
    "doses_administered": {
     "unit": "doses (vaccinations)",
     "def": "polio vaccinations recorded, adding ALL rounds and records (MR excluded; co-administered rows hold the larger of the two vaccine totals). The same child is counted once per round: this is the dashboard's 'Doses administered' tile, NOT the number of children vaccinated",
     "formula": "sum(TotalNbrVaccPolio) where Vaccine_type != 'MR'",
     "expr": "df[df.Vaccine_type!='MR'].TotalNbrVaccPolio.sum()",
     "kind": "scalar"
    },
    "rounds": {
     "unit": "rounds",
     "def": "campaign rounds with records: distinct (country, response, round, vaccine type)",
     "formula": "distinct (Country, Response, Round_Add, Vaccine_type)",
     "expr": "len(df[['Country','Response','Round_Add','Vaccine_type']].drop_duplicates())",
     "kind": "scalar"
    }
   },
   "warnings": [
    {
     "metrics": [
      "children_vaccinated",
      "doses_administered"
     ],
     "count": "int(df.Vaccine_type.isin(['nOPV2 & bOPV','nOPV2_bOPV_IPV']).sum())",
     "text": "Co-administered rows (nOPV2 & bOPV, nOPV2_bOPV_IPV) hold ONE figure per district: the larger of the two vaccine totals. The nOPV2 and bOPV totals must never be added together; if you were asked to add them, say that they should not be added."
    },
    {
     "metrics": [
      "coverage",
      "share_districts_95",
      "children_vaccinated",
      "doses_administered"
     ],
     "count": "int(((df.TotalNbrVaccPolio/df.PopPolio)>1.5).sum())",
     "text": "{n} record(s) in this selection have coverage above 1.5 (not credible)."
    },
    {
     "metrics": [
      "children_vaccinated",
      "coverage",
      "doses_administered",
      "share_districts_95",
      "target_population"
     ],
     "text": "Measles-rubella (MR) records are excluded from this polio figure."
    },
    {
     "metrics": [
      "doses_administered"
     ],
     "text": "This adds ALL rounds: the same child is counted once per round, so it is a number of vaccinations (doses), not of children. The dashboard's 'Children vaccinated' (metric children_vaccinated) takes the best month of each country; say which one you give."
    },
    {
     "metrics": [
      "children_vaccinated"
     ],
     "text": "Dashboard definition: for each country the month with the most vaccinations, summed over countries; it estimates distinct children and does not add rounds. The sum of all rounds is metric doses_administered."
    },
    {
     "metrics": [
      "campaigns"
     ],
     "text": "This counts campaign NAMES; a campaign has several rounds (metric rounds)."
    }
   ],
   "sources": [
    {
     "kind": "admin",
     "path": "@data/AFRO_admin_operations_center/ops_work/backup_repo/snapshots/admin/AFRO_admin_data__*.xlsx"
    },
    {
     "kind": "rds",
     "path": "@dash/input/AFRO_admin_data.rds"
    },
    {
     "kind": "rds",
     "path": "@here/data/AFRO_admin_data.rds"
    }
   ],
   "round_key": [
    "response",
    "round"
   ]
  },
  "form_a": {
   "semantic": "form_a",
   "date_col": "report_date",
   "entity": "reports",
   "usecols": [
    "record_uuid",
    "iso3",
    "country",
    "region",
    "district",
    "vaccine",
    "template",
    "round",
    "report_date",
    "report_year",
    "level",
    "is_latest_of_place",
    "qc_flags",
    "children_vaccinated",
    "wastage_rate",
    "unaccounted_vials",
    "vials_distributed",
    "vials_received",
    "doses_used"
   ],
   "latest": {
    "col": "is_latest_of_place",
    "default": true,
    "note": "only the last report of a place and round counts"
   },
   "dims": {
    "country": "country",
    "year": "report_year",
    "vaccine": "vaccine",
    "level": "level",
    "template": "template",
    "round": "round"
   },
   "metrics": {
    "reports": {
     "unit": "reports",
     "def": "number of reports",
     "formula": "number of rows",
     "expr": "len(df)",
     "kind": "scalar",
     "all_rows": true
    },
    "countries": {
     "unit": "countries",
     "def": "distinct countries with reports",
     "formula": "distinct country",
     "expr": "df.country.nunique()",
     "kind": "scalar",
     "all_rows": true
    },
    "children_vaccinated": {
     "unit": "children",
     "def": "children vaccinated reported by the places; add only reports of ONE level (filter level)",
     "formula": "sum(children_vaccinated)",
     "expr": "df.children_vaccinated.sum()",
     "kind": "scalar"
    },
    "median_wastage_rate": {
     "unit": "percent",
     "def": "median wastage rate of the selected reports (can be negative)",
     "formula": "median(wastage_rate)",
     "expr": "df.wastage_rate.median()",
     "kind": "scalar"
    },
    "median_wastage_rate_unflagged": {
     "unit": "percent",
     "def": "median wastage rate leaving out reports flagged wastage_negative, wastage_over_100 or implausible_number",
     "formula": "median(wastage_rate) of unflagged reports",
     "expr": "df[~df.qc_flags.fillna('').str.contains('wastage_negative|wastage_over_100|implausible_number')].wastage_rate.median()",
     "kind": "scalar"
    },
    "unaccounted_vials": {
     "unit": "vials",
     "def": "vials distributed minus vials back from the lower level; negative = more back than distributed",
     "formula": "sum(unaccounted_vials)",
     "expr": "df.unaccounted_vials.sum()",
     "kind": "scalar"
    },
    "share_with_qc_flag": {
     "unit": "percent of reports",
     "def": "share of reports with at least one QC flag",
     "formula": "100 * mean(!is.na(qc_flags))",
     "expr": "100*df.qc_flags.notna().mean()",
     "kind": "scalar",
     "all_rows": true
    },
    "reports_stock_mismatch": {
     "unit": "reports",
     "def": "reports flagged stock_mismatch (theoretical stock differs from the physical count)",
     "formula": "count of qc_flags containing stock_mismatch",
     "expr": "df.qc_flags.fillna('').str.contains('stock_mismatch').sum()",
     "kind": "scalar",
     "all_rows": true
    }
   },
   "warnings": [
    {
     "metrics": [
      "children_vaccinated",
      "unaccounted_vials"
     ],
     "count": "int(df.level.nunique())",
     "min_count": 2,
     "text": "The selection mixes %d levels: reports of different levels are never added together; filter one level."
    },
    {
     "metrics": [
      "median_wastage_rate"
     ],
     "count": "int(df.qc_flags.fillna('').str.contains('wastage_negative').sum())",
     "text": "{n} report(s) in this selection have a negative wastage rate (more children than doses used); median_wastage_rate_unflagged leaves the flagged reports out (give it only when asked, and say which one you give)."
    }
   ],
   "sources": [
    {
     "kind": "csv",
     "path": "@data/AFRO-Form-A-data-workflow/data/final/afro_form_a_repository.csv"
    }
   ]
  },
  "preparedness": {
   "semantic": "preparedness",
   "date_col": "report_date",
   "entity": "visits",
   "usecols": [
    "record_uuid",
    "iso3",
    "country",
    "district",
    "round",
    "report_date",
    "report_year",
    "level",
    "is_latest_of_place",
    "readiness_pct",
    "items_answered",
    "items_ready",
    "qc_flags",
    "ready_Microplan",
    "ready_ColdChain_Logistics",
    "ready_SocialMobilization",
    "ready_Training"
   ],
   "latest": {
    "col": "is_latest_of_place",
    "default": true,
    "note": "readiness is over places (the last visit of each place and round), not over visits"
   },
   "dims": {
    "country": "country",
    "year": "report_year",
    "level": "level",
    "round": "round"
   },
   "metrics": {
    "visits": {
     "unit": "visits",
     "def": "number of visits (places when only the latest visits are kept)",
     "formula": "number of rows",
     "expr": "len(df)",
     "kind": "scalar",
     "all_rows": true
    },
    "countries": {
     "unit": "countries",
     "def": "distinct countries",
     "formula": "distinct country",
     "expr": "df.country.nunique()",
     "kind": "scalar",
     "all_rows": true
    },
    "mean_readiness": {
     "unit": "percent",
     "def": "mean readiness of the selected visits (readiness_pct = items ready / items answered)",
     "formula": "mean(readiness_pct)",
     "expr": "df.readiness_pct.mean()",
     "kind": "scalar"
    },
    "mean_readiness_microplan": {
     "unit": "percent",
     "def": "mean readiness of the microplan section",
     "formula": "mean(ready_Microplan)",
     "expr": "df.ready_Microplan.mean()",
     "kind": "scalar"
    },
    "mean_readiness_coldchain": {
     "unit": "percent",
     "def": "mean readiness of the cold chain and logistics section",
     "formula": "mean(ready_ColdChain_Logistics)",
     "expr": "df.ready_ColdChain_Logistics.mean()",
     "kind": "scalar"
    },
    "mean_readiness_socialmob": {
     "unit": "percent",
     "def": "mean readiness of the social mobilization section",
     "formula": "mean(ready_SocialMobilization)",
     "expr": "df.ready_SocialMobilization.mean()",
     "kind": "scalar"
    },
    "mean_readiness_training": {
     "unit": "percent",
     "def": "mean readiness of the training section",
     "formula": "mean(ready_Training)",
     "expr": "df.ready_Training.mean()",
     "kind": "scalar"
    },
    "visits_flag_all_yes": {
     "unit": "visits",
     "def": "visits with the QC flag all_yes (12 or more questions answered and all ready): to check",
     "formula": "count of qc_flags containing all_yes",
     "expr": "df.qc_flags.fillna('').str.contains('all_yes').sum()",
