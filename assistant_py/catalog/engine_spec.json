   },
   "metrics": {
    "reports": {
     "unit": "reports",
     "def": "number of reports (a ward and campaign-day each)",
     "formula": "number of rows",
     "expr": "len(df)",
     "kind": "scalar"
    },
    "valid_reports": {
     "unit": "reports",
     "def": "reports whose vial counts are valid (both 0-5,000, returned <= received)",
     "formula": "sum(vials_valid)",
     "expr": "(df.vials_valid.astype(str)=='True').sum()",
     "kind": "scalar"
    },
    "pct_returned": {
     "unit": "percent of vials received",
     "def": "vials returned over vials received, ratio of sums over valid reports (never the mean of the pct_returned column)",
     "formula": "100 * sum(vials_returned) / sum(vials_received) over valid reports",
     "expr": "(lambda d: 100*d.vials_returned.sum()/d.vials_received.sum())(df[df.vials_valid.astype(str)=='True'])",
     "kind": "scalar"
    },
    "vials_received": {
     "unit": "vials",
     "def": "vials received over valid reports",
     "formula": "sum(vials_received)",
     "expr": "df[df.vials_valid.astype(str)=='True'].vials_received.sum()",
     "kind": "scalar"
    },
    "vials_returned": {
     "unit": "vials",
     "def": "vials returned over valid reports",
     "formula": "sum(vials_returned)",
     "expr": "df[df.vials_valid.astype(str)=='True'].vials_returned.sum()",
     "kind": "scalar"
    },
    "reports_returned_gt_received": {
     "unit": "reports",
     "def": "reports where returned exceeds received (left out of the totals)",
     "formula": "sum(vials_returned_gt_received)",
     "expr": "(df.vials_returned_gt_received.astype(str)=='True').sum()",
     "kind": "scalar"
    }
   },
   "warnings": [
    {
     "metrics": [
      "pct_returned",
      "vials_returned"
     ],
     "text": "What 'returned' means is to be confirmed with the form owner: do not present 100 minus the percentage as vials lost or not returned."
    }
   ],
